{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/study/**",
              "ui_kits/central-de-estudos/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo Black|Nunito|Instrument Serif|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo Black, Nunito, Instrument Serif, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|title|action|pending|online|tone|key|ref|className|style|children)$/]",
        "message": "<AppNav> doesn't accept that prop. Declared props: brand, title, action, pending, online, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|sticker|trailing|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, sticker, trailing, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|radius|pad|outlined|sticker|span|rows|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, radius, pad, outlined, sticker, span, rows, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:xs|sm|md|lg|xl|panel|pill)$/]",
        "message": "<Card> radius must be one of 'xs' | 'sm' | 'md' | 'lg' | 'xl' | 'panel' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> pad must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DurationPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|options|on|key|ref|className|style|children)$/]",
        "message": "<DurationPicker> doesn't accept that prop. Declared props: value, onChange, options, on."
      },
      {
        "selector": "JSXOpeningElement[name.name='DurationPicker'] > JSXAttribute[name.name='on'] > Literal[value!=/^(?:canvas|light)$/]",
        "message": "<DurationPicker> on must be one of 'canvas' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Face'] > JSXAttribute > JSXIdentifier[name!=/^(?:mood|size|tone|key|ref|className|style|children)$/]",
        "message": "<Face> doesn't accept that prop. Declared props: mood, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Face'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|light|cream)$/]",
        "message": "<Face> tone must be one of 'ink' | 'light' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlashcardShape'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|front|back|key|ref|className|style|children)$/]",
        "message": "<FlashcardShape> doesn't accept that prop. Declared props: kind, front, back."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlashcardShape'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:pergunta_resposta|resumo)$/]",
        "message": "<FlashcardShape> kind must be one of 'pergunta_resposta' | 'resumo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|track|height|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, tone, track, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestionShape'] > JSXAttribute > JSXIdentifier[name!=/^(?:format|statement|alternatives|correct_answer|key|ref|className|style|children)$/]",
        "message": "<QuestionShape> doesn't accept that prop. Declared props: format, statement, alternatives, correct_answer."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestionShape'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:certo_errado|multipla_escolha)$/]",
        "message": "<QuestionShape> format must be one of 'certo_errado' | 'multipla_escolha'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|total|secondsLeft|elapsed|onExit|key|ref|className|style|children)$/]",
        "message": "<SessionHeader> doesn't accept that prop. Declared props: index, total, secondsLeft, elapsed, onExit."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionStats'] > JSXAttribute > JSXIdentifier[name!=/^(?:questionsAnswered|questionsCorrect|cardsReviewed|elapsedSeconds|subjects|key|ref|className|style|children)$/]",
        "message": "<SessionStats> doesn't accept that prop. Declared props: questionsAnswered, questionsCorrect, cardsReviewed, elapsedSeconds, subjects."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|footer|children|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, onClose, title, footer, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|size|align|mono|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, size, align, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<StatBlock> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatBlock> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onNavigate|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: items, active, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeekStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:days|labels|caption|onSelect|key|ref|className|style|children)$/]",
        "message": "<WeekStrip> doesn't accept that prop. Declared props: days, labels, caption, onSelect."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
